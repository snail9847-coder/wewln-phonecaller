# wewln-phonecaller: example settings. Copy to .env (PowerShell: Copy-Item .env.example .env).
# .env is ignored by git. Never put real tokens into .env.example.
# Precedence: environment variables > .env > defaults. Check with: python -m wewln_phonecaller check-config

# --- Safety -------------------------------------------------------------------
# simulation (default) or production. In simulation no real call is ever placed.
# A real call needs ALL of: production mode + confirmation phrase, a real provider
# (asterisk) that is configured, WEWLN_CALL_REGIONS, no emergency stop and the
# operator's permit for that one number (wewln calls permit). Campaign calls over a
# real provider are not enabled in this version at all.
WEWLN_MODE=simulation
# WEWLN_MODE=production also needs this exact confirmation phrase:
# WEWLN_PRODUCTION_CONFIRM=I_ACCEPT_REAL_CALLS
# Emergency stop: true blocks every call (also: wewln calls stop-all / resume).
WEWLN_KILL_SWITCH=false
# mock: simulated calls only (default). asterisk: your own Asterisk over ARI
# (docs/ASTERISK.md); it reaches phones only through a SIP trunk you configure.
WEWLN_TELEPHONY_PROVIDER=mock

# --- Calls ----------------------------------------------------------------------
# Countries numbers may be called in (ISO codes, comma-separated), e.g. AZ or AZ,RU.
# Required for real calls. A valid +7/+994 number is NOT proof that it is reachable
# or that you may call it. Premium-rate and similar numbers are never called.
WEWLN_CALL_REGIONS=
# Seconds a call may ring before it counts as "no answer" (5-120).
WEWLN_CALL_RING_TIMEOUT=30
# Longest conversation in seconds; then wewln hangs up (10-3600).
WEWLN_CALL_MAX_DURATION=300
# Seconds before the next attempt after busy / no answer (60-86400); the number of
# attempts is the campaign's «Макс. попыток» (1-5).
WEWLN_CALL_RETRY_DELAY=900
# Mock provider behaviour: answer, busy, no_answer, reject, unreachable, fail,
# silent, answer_hold, or mixed (by the last digit of the number).
WEWLN_MOCK_SCENARIO=answer
# Caller ID sent with calls (E.164); your SIP provider may override it.
# WEWLN_CALLER_ID=

# --- Asterisk (WEWLN_TELEPHONY_PROVIDER=asterisk; docs/ASTERISK.md) ------------
# ARI address. WSL2 forwards localhost to Linux, so 127.0.0.1 works from Windows.
# Plain http only on this computer; https for Asterisk on another machine.
WEWLN_ARI_URL=http://127.0.0.1:8088
WEWLN_ARI_USERNAME=wewln
# The ARI password is best kept in the Credential Manager:
#   wewln telephony secret set ari-password
# WEWLN_ARI_PASSWORD=
# Stasis application name (must match nothing else on that Asterisk).
WEWLN_ARI_APP=wewln
# Dial string: {number} is replaced by the number in WEWLN_ASTERISK_NUMBER_FORMAT.
WEWLN_ASTERISK_ENDPOINT=PJSIP/{number}@wewln-trunk
# e164 (+994501234567), digits (994501234567) or 00 (00994501234567): what the
# SIP provider expects.
WEWLN_ASTERISK_NUMBER_FORMAT=e164
# Local softphone (MicroSIP) for free tests without the phone network.
WEWLN_ASTERISK_SOFTPHONE_ENDPOINT=PJSIP/softphone
# Played after the answer until the voice engine exists (Phase 5); empty: hang up.
WEWLN_ASTERISK_ANSWER_MEDIA=sound:hello-world

# --- Call-status webhooks (optional) ---------------------------------------------
# POST /api/v1/telephony/events, signed with HMAC-SHA256; closed while not set.
#   wewln telephony secret set webhook-secret --generate --show
# WEWLN_WEBHOOK_SECRET=
# Accepted clock difference in seconds (30-900).
WEWLN_WEBHOOK_TOLERANCE=300

# --- Local HTTP API -----------------------------------------------------------
WEWLN_HTTP_HOST=127.0.0.1
WEWLN_HTTP_PORT=8787
# Bearer token for protected endpoints (/api/...), at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required when WEWLN_HTTP_HOST is not a loopback address.
# WEWLN_API_TOKEN=

# --- Data and logs --------------------------------------------------------------
# Relative paths are resolved from the folder where the program is started.
WEWLN_DATA_DIR=data
# Default: <WEWLN_DATA_DIR>/wewln.db
# WEWLN_DB_PATH=data/wewln.db
WEWLN_LOG_LEVEL=INFO
# json (one JSON object per line) or text
WEWLN_LOG_FORMAT=json
WEWLN_LOG_TO_FILE=true
# Default: <WEWLN_DATA_DIR>/logs/wewln.log (rotated: 5 files x 5 MB)
# WEWLN_LOG_FILE=data/logs/wewln.log

# --- Language and time ------------------------------------------------------------
# Conversation language. Russian is mandatory; more languages will be added later.
WEWLN_DEFAULT_LANGUAGE=ru-RU
# IANA time zone, for example Asia/Baku or Europe/Moscow
WEWLN_TIMEZONE=Asia/Baku
# Country (ISO 3166-1 code, for example AZ or RU) for phone numbers written without
# the international prefix. Empty: such numbers are rejected ("needs a country code").
# WEWLN_DEFAULT_PHONE_REGION=AZ

# --- Notion (optional; the backend works without it) ------------------------------
# Step-by-step setup: docs/NOTION.md
WEWLN_NOTION_ENABLED=false
# The token is best kept in the Windows Credential Manager: wewln notion token set
# Alternatively an environment variable (never commit it to git):
# WEWLN_NOTION_TOKEN=
# Database IDs or links; `wewln notion bootstrap --parent <page>` creates the databases
# and prints these lines (--write-env saves them here).
# WEWLN_NOTION_CAMPAIGNS_DB=
# WEWLN_NOTION_CONTACTS_DB=
# WEWLN_NOTION_JOBS_DB=
# WEWLN_NOTION_RESULTS_DB=
# Seconds between sync cycles of `wewln serve` (15-86400).
WEWLN_NOTION_SYNC_INTERVAL=60
# Requests per second (Notion allows about 3 per connection on average).
WEWLN_NOTION_MAX_RPS=2.5
# Seconds before a Notion request is given up.
WEWLN_NOTION_TIMEOUT=30
# Only for trials with the local mock: wewln notion mock-server prints the address.
WEWLN_NOTION_API_BASE_URL=https://api.notion.com
